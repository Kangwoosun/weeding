FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

ARG VITE_BASE_PATH=/
ARG VITE_INVITATION_URL=http://woosuneunhye.c0w5un.xyz:65500/
ARG VITE_KAKAO_SDK_JS_KEY=
ARG VITE_NAVER_MAP_CLIENT_ID=
ARG VITE_SERVER_URL=/api
ARG VITE_STATIC_ONLY=false

ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_INVITATION_URL=$VITE_INVITATION_URL
ENV VITE_KAKAO_SDK_JS_KEY=$VITE_KAKAO_SDK_JS_KEY
ENV VITE_NAVER_MAP_CLIENT_ID=$VITE_NAVER_MAP_CLIENT_ID
ENV VITE_SERVER_URL=$VITE_SERVER_URL
ENV VITE_STATIC_ONLY=$VITE_STATIC_ONLY

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
